# ===== 网络 =====
HOST=127.0.0.1
PORT=3090
DATA_FILE=data/accounts.json

# ===== 鉴权 =====
# 管理端令牌：保护 /admin/* 与 /metrics（不设置则本地开放）
ADMIN_TOKEN=
# 代理端令牌：保护 /v1/chat/completions 与 /v1/embeddings（不设置则开放）
PROXY_AUTH_TOKEN=

# ===== 超时与重试 =====
UPSTREAM_TIMEOUT_MS=60000      # 上游整体超时（连接+读取）
CONNECT_TIMEOUT_MS=8000        # 连接建立超时
STREAM_IDLE_TIMEOUT_MS=30000   # 流式响应空闲超时（上游久不发数据则中断）
MAX_CONCURRENCY_PER_ACCOUNT=0  # 每账号最大并发（0=不限）
CONSECUTIVE_FAILURE_LIMIT=0    # 连续错误达此值自动熔断禁用（0=关闭）

# ===== 选号与路由 =====
POOL_STRATEGY=weighted         # weighted | round_robin | least_used
ALIASES=                       # 别名串："别名:真名1,真名2;别名2:真名3"（或改用 config/aliases.json）

# ===== 跨域与日志 =====
ALLOW_CORS=                    # 设为 * 或具体源以开启 CORS（留空关闭）
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FILE=                      # 设置后日志同时写文件并按大小轮转
LOG_FILE_MAX_BYTES=10485760    # 单文件上限（默认 10MB）
LOG_FILE_KEEP=3                # 保留历史份数（默认 3）
